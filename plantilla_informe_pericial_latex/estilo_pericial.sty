			{\small\textcolor{GrisOscuro}{Ingeniero en Informática --- Col. n.\textsuperscript{o} \NumColegiadoTres}} &
			\textbf{\textcolor{GrisOscuro}{\PeritoCuatro}} \newline
			{\small\textcolor{GrisOscuro}{Ingeniero en Informática --- Col. n.\textsuperscript{o} \NumColegiadoCuatro}} \\
		\end{tabularx}
		
		\vspace{1.8cm}
		{\Huge\bfseries\textcolor{AzulPericial}{\TituloInforme}} \\[0.4cm]
		{\Large\bfseries\textcolor{GrisOscuro}{\SubtituloDocumento}}
		
		\vspace{0.6cm}
		\textcolor{AzulPericial}{\rule{\textwidth}{1.5pt}}
		
		\vspace{1.3cm}
		\renewcommand{\arraystretch}{1.45}
		\begin{tabularx}{\textwidth}{@{} >{\bfseries\color{AzulPericial}}p{3.4cm} X @{}}
